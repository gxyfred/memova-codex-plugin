{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memova.ai/schemas/conversation-sync/hook-hint-v1.schema.json",
  "title": "Memova Codex Hook Hint V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "session_id", "observed_at"],
  "properties": {
    "schema_version": {"const": "memova_codex_hook_hint_v1"},
    "event": {"enum": ["UserPromptSubmit", "Stop", "SessionEnd"]},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "turn_id": {"type": ["string", "null"], "maxLength": 256},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "description": "An optional content-free activity audit marker. It is not a sync trigger and must never contain prompt, response, tool, file, or terminal content."
}
